rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- REGLAS PARA USUARIOS (Sin cambios, funcionan) ---
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read: if request.auth != null;
      allow update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // --- REGLAS PARA TURNOS (MODIFICADAS PARA CORRECCIÓN) ---
    match /shifts/{shiftId} {
      // Regla simplificada: Cualquier usuario autenticado puede leer los turnos.
      allow read: if request.auth != null;
      
      // La escritura sigue estando restringida solo a los administradores.
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
  }
}
